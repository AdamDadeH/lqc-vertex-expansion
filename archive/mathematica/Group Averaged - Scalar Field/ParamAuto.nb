Notebook[{

Cell[CellGroupData[{
Cell["\<\
New version of the autoamplitude program based on the exact matrix elements \
Miguel included in the longer analytical paper.\
\>", "Subsubtitle",
 CellChangeTimes->{{3.5095507279891376`*^9, 3.509550754670429*^9}, {
  3.509550924220161*^9, 3.5095509246776*^9}},
 EmphasizeSyntaxErrors->True],

Cell["\<\
Generating function used to define the physical states - we need to check \
these against the solutions we had before just to make sure....\
\>", "Subsubtitle",
 CellChangeTimes->{{3.5095543714403954`*^9, 3.509554385654044*^9}, {
  3.5095556472756567`*^9, 3.5095556582843*^9}, {3.510516107192918*^9, 
  3.5105161083182163`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"FId", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "2"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "x"}], "]"}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         FractionBox[
          RowBox[{"Log", "[", "x", "]"}], 
          RowBox[{"2", "\[Pi]"}]]}]}], "]"}], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.51042632148387*^9, 3.510426322662632*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The following are the generating functions used to obtain the matrix elements \
of $\\sqrt {\\Theta}/(\\sqrt {12\\pi G}), the identity operators, and the \
evolution operator respectively.\
\>", "Subsubtitle",
 CellChangeTimes->{{3.509561676269759*^9, 3.509561758276065*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ThK", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"n", "*", "m"}], "]"}]}], 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"n", "+", "m"}], ")"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ThD", "[", "n_", "]"}], ":=", 
  RowBox[{"2", " ", 
   SuperscriptBox["n", "2"]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Aexact", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"n", "*", "m"}], "]"}], " ", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      RowBox[{"FId", "[", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", "x"], 
        FractionBox[
         RowBox[{"1", "+", "s"}], 
         RowBox[{"1", "-", "s"}]], 
        FractionBox[
         RowBox[{"1", "-", "t"}], 
         RowBox[{"1", "+", "t"}]]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", 
        RowBox[{"2", "n"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "m"}]}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.5095511838870087`*^9, 3.5095511840729923`*^9}, {
   3.5095512832685957`*^9, 3.509551430538755*^9}, {3.509551563491413*^9, 
   3.509551573421863*^9}, {3.5095588032722187`*^9, 3.509558804325869*^9}, {
   3.510425424683874*^9, 3.51042542609142*^9}, 3.5104255233540297`*^9, {
   3.510425681521936*^9, 3.510425701882069*^9}, {3.5104257489946003`*^9, 
   3.51042581210355*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The following are the definitions required for the algorithm to function.  \
Degen and w together identify the number of distinct volumes taken along the \
path and count the degeneracy of the values.\
\>", "Subsubtitle",
 CellChangeTimes->{{3.509551528226922*^9, 3.509551528397645*^9}, {
  3.5095517806920767`*^9, 3.509551818142198*^9}, {3.5095518569765177`*^9, 
  3.5095518668247423`*^9}, {3.509552176242692*^9, 3.509552204555735*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"degen", "[", "v_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{
       RowBox[{"Split", "[", 
        RowBox[{"Sort", "[", "v", "]"}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"Split", "[", 
         RowBox[{"Sort", "[", "v", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"w", "[", "v_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Split", "[", 
        RowBox[{"Sort", "[", "v", "]"}], "]"}], "[", 
       RowBox[{"[", "i", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"Split", "[", 
         RowBox[{"Sort", "[", "v", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "w_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ThD", "[", 
      RowBox[{"w", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.509551821065878*^9, 3.509551821125531*^9}, {
  3.5095518688897448`*^9, 3.509551982172653*^9}, {3.509552699027712*^9, 
  3.5095527301781263`*^9}, {3.509552803593892*^9, 3.509552804388267*^9}, {
  3.50955312786982*^9, 3.5095531674723*^9}, {3.510425865913813*^9, 
  3.510425869854575*^9}, {3.510425926544924*^9, 3.51042592742393*^9}}],

Cell["\<\
The following produces the diagonal matrix elements corresponding to the \
distinct values of volume.\
\>", "Text",
 CellChangeTimes->{{3.509552244842093*^9, 3.509552300141953*^9}, {
  3.509552598709093*^9, 3.5095525993021173`*^9}}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.509552301331555*^9, 3.50955230726087*^9}, 
   3.509552697614388*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Note that if we take x in the following equations to be Sqrt[12 \[Pi] G] then \
we are not missing any factors and the result is exact.
Simply need to call Amplitude with the full history in volume.\
\>", "Subsubtitle",
 CellChangeTimes->{{3.509552601714431*^9, 3.509552640613784*^9}, {
  3.509561784566105*^9, 3.509561800443943*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IPartBase", "[", 
    RowBox[{"w_", ",", "deg_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Product", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"deg", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}], "!"}]], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", "*", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"d", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "*", "x"}]], 
       RowBox[{"Product", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"d", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}], "*", " ", 
       RowBox[{"Product", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "-", 
           RowBox[{"d", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}]], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", 
           RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IPartDer", "[", 
    RowBox[{"w_", ",", "deg_"}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
     RowBox[{"IPartBase", "[", 
      RowBox[{"w", ",", "deg"}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"deg", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "w", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IPart", "[", 
   RowBox[{"w_", ",", "deg_", ",", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"IPartDer", "[", 
     RowBox[{"w", ",", "deg"}], "]"}], "]"}], "/.", 
   RowBox[{"d", "\[Rule]", "c"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProdPart", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"ThK", "[", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"v", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{
        RowBox[{"Length", "[", "v", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Amplitude", "[", "v_", "]"}], ":=", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"wv", "=", 
      RowBox[{"w", "[", "v", "]"}]}], ";", " ", 
     RowBox[{"deg", "=", 
      RowBox[{"degen", "[", "v", "]"}]}], ";", " ", 
     RowBox[{"diagl", "=", 
      RowBox[{"c", "[", "wv", "]"}]}], ";", "  ", 
     RowBox[{
      RowBox[{"ProdPart", "[", "v", "]"}], "*", 
      RowBox[{"IPart", "[", 
       RowBox[{"wv", ",", " ", "deg", ",", " ", "diagl"}], "]"}]}]}], ")"}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.509552642358027*^9, 3.5095526567739687`*^9}, 
   3.509552822183939*^9, {3.509553241904109*^9, 3.509553354048335*^9}, {
   3.509553386628805*^9, 3.509553414564206*^9}, {3.509553674319775*^9, 
   3.5095537274358377`*^9}, {3.5095610299698477`*^9, 3.509561030591905*^9}, {
   3.509561778954534*^9, 3.5095617802025843`*^9}, {3.510425829400776*^9, 
   3.5104258303567333`*^9}, {3.510426052243402*^9, 3.510426053036447*^9}, {
   3.510426416170258*^9, 3.510426418466413*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tools for generating sets of paths!", "Subsubtitle",
 CellChangeTimes->{{3.509563327730858*^9, 3.509563338889176*^9}, {
   3.509563377408184*^9, 3.509563378209401*^9}, 3.509566221658266*^9}],

Cell["\<\
Changes generates a set of possible changes between two equal volumes but \
only over single steps
Paths then generates the actual sets of paths here starting from volume = 4
NullPath checks to see if that path passes through zero
ManyAmp then computes the amplitude for a whole set of paths\
\>", "Text",
 CellChangeTimes->{{3.509566014282987*^9, 3.509566067344802*^9}, 
   3.509566221658478*^9}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Changes", "[", 
    RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"diff", "=", 
      RowBox[{"(", 
       RowBox[{"vf", "-", "vi"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"base", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"m", "/", "2"}], "+", 
             RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"m", "/", "2"}], "-", 
             RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"changes", "=", 
      RowBox[{"Permutations", "[", "base", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"numpaths", "=", 
      RowBox[{"Length", "[", "changes", "]"}]}], ";", "\[IndentingNewLine]", 
     " ", 
     RowBox[{"initial", " ", "=", " ", "vi"}], ";"}], ")"}]}], 
  "\[IndentingNewLine]", "    "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Paths", "[", "changes_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"numpaths", "=", 
      RowBox[{"Length", "[", "changes", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"changes", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"paths", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numpaths"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"path", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"initial", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", "numpaths"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"valid", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", "m"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"path", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"changes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "<", "1"}], ",", 
             RowBox[{"valid", "=", "0"}]}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"valid", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"paths", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "=", "path"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"k", "++"}], ";"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"numpaths", "=", 
      RowBox[{"k", "-", "1"}]}], ";"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ManyAmp", "[", 
   RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Changes", "[", 
     RowBox[{"m", ",", "vi", ",", "vf"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Paths", "[", "changes", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Many", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", "numpaths"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Many", "=", 
       RowBox[{"Many", "+", 
        RowBox[{"Amplitude", "[", 
         RowBox[{"paths", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", ";", "\[IndentingNewLine]", "Many"}], 
   ")"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.509563379269491*^9, 3.509563455644796*^9}, {
   3.509563516648714*^9, 3.509563556340858*^9}, {3.509564054136085*^9, 
   3.509564076502627*^9}, {3.509564124677075*^9, 3.509564142773611*^9}, {
   3.509564240322379*^9, 3.509564338629023*^9}, {3.50956438691428*^9, 
   3.509564399531962*^9}, 3.509564515278738*^9, {3.509564607518482*^9, 
   3.509564628054736*^9}, {3.5095646728707867`*^9, 3.509564676968173*^9}, {
   3.509564734700139*^9, 3.509564746998363*^9}, {3.50956493337162*^9, 
   3.5095651172653913`*^9}, {3.509565225099945*^9, 3.509565234983445*^9}, {
   3.50956555635707*^9, 3.509565665305564*^9}, {3.5095657569918833`*^9, 
   3.50956588219516*^9}, {3.509566098546548*^9, 3.509566119578354*^9}, 
   3.509566221659812*^9, {3.5095663907685823`*^9, 3.509566391104568*^9}, {
   3.509566479445973*^9, 3.509566487502658*^9}, {3.510516064568459*^9, 
   3.51051607785847*^9}, {3.510516146615575*^9, 3.510516168060295*^9}, {
   3.514730152564849*^9, 3.51473015319132*^9}, {3.5147301937491293`*^9, 
   3.51473030668841*^9}, {3.514730398551791*^9, 3.514730403498275*^9}, {
   3.514730434142838*^9, 3.514730436536364*^9}}],

