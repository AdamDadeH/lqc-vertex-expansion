Notebook[{
Cell["\<\
First these are the necessary functions to define the exact amplitude.\
\>", "Text",
 CellChangeTimes->{{3.510519024085103*^9, 3.510519054240499*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FId", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "2"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "x"}], "]"}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", 
         FractionBox[
          RowBox[{"Log", "[", "x", "]"}], 
          RowBox[{"2", "\[Pi]"}]]}]}], "]"}], "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Aexact", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"n", "*", "m"}], "]"}], " ", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      RowBox[{"FId", "[", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", "x"], 
        FractionBox[
         RowBox[{"1", "+", "s"}], 
         RowBox[{"1", "-", "s"}]], 
        FractionBox[
         RowBox[{"1", "-", "t"}], 
         RowBox[{"1", "+", "t"}]]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", 
        RowBox[{"2", "n"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "m"}]}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.510516633811792*^9, 3.510516645118744*^9}, {
  3.5105190305153847`*^9, 3.510519031131763*^9}}],

Cell[BoxData[
 RowBox[{"The", " ", "matrix", " ", "elements", " ", "of", " ", "the", " ", 
  "constraint", " ", 
  RowBox[{"operator", ".", "  ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["p", "2"], "-", 
     FractionBox["\[CapitalTheta]", 
      RowBox[{"12", "\[Pi]", " ", "G"}]]}], ")"}]}], " ", "where", " ", "is", 
  " ", "not", " ", "the", " ", "original", " ", "scalar", " ", "field", " ", 
  "momentum", " ", "but", " ", "is", " ", "rescaled", " ", "by", " ", "12", 
  "\[Pi]", " ", "G", " ", "appropriately"}]], "Text",
 CellChangeTimes->{{3.510519055521908*^9, 3.5105191586195297`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OffD", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"n", "*", "m"}], "]"}], 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"n", "+", "m"}], ")"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Diag", "[", "n_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["p", "2"], "-", 
   RowBox[{"2", " ", 
    SuperscriptBox["n", "2"]}]}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.5105166457109203`*^9, 3.510516646437005*^9}, {
   3.5105167790878067`*^9, 3.510516785151348*^9}, {3.5105169063763847`*^9, 
   3.510516911968726*^9}, 3.510519029321834*^9}],

Cell["\<\
These are the functions generating the amplitudes.  Nume, Denom , and Amp \
together defines the amplitude for each path.  Changes and Paths together \
define the space of paths given a set number of transitions.  Finally ManyAmp \
generates the overall amplitude for the full set of paths with a fixed number \
of transitions\
\>", "Text",
 CellChangeTimes->{{3.5105191616675053`*^9, 3.510519236651265*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Nume", "[", "v_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"Length", "[", "v", "]"}], "-", "1"}]]}], 
     RowBox[{"2", "\[Pi]"}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"OffD", "[", 
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"v", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{
         RowBox[{"Length", "[", "v", "]"}], "-", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Denom", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Diag", "[", 
       RowBox[{"v", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Amp", "[", "v_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Nume", "[", "v", "]"}], 
    RowBox[{"(", 
     FractionBox["1", 
      RowBox[{"Denom", "[", "v", "]"}]], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Changes", "[", 
   RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"(", 
      RowBox[{"vf", "-", "vi"}], ")"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"base", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "+", 
            RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", 
            RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"changes", "=", 
     RowBox[{"Permutations", "[", "base", "]"}]}], ";", "\[IndentingNewLine]",
     
    RowBox[{"numpaths", "=", 
     RowBox[{"Length", "[", "changes", "]"}]}], ";"}], 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Paths", "[", 
    RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"paths", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numpaths"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"path", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"vi", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", "numpaths"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", "m"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"path", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"changes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"paths", "[", 
          RowBox[{"[", "j", "]"}], "]"}], "=", "path"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NullPath", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ManyAmp", "[", 
   RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Changes", "[", 
     RowBox[{"m", ",", "vi", ",", "vf"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Paths", "[", 
     RowBox[{"m", ",", "vi", ",", "vf"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Many", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", 
       RowBox[{"Length", "[", "paths", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NullPath", "[", 
           RowBox[{"paths", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{"Many", "=", "Many"}], ",", 
         RowBox[{"Many", "=", 
          RowBox[{"Many", "+", 
           RowBox[{"Amp", "[", 
            RowBox[{"paths", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "Many"}], 
   ")"}]}]}], "Input",
 CellChangeTimes->{{3.5105166854806433`*^9, 3.510516686307023*^9}, {
  3.510516823425445*^9, 3.510516844314296*^9}, {3.510516882449637*^9, 
  3.5105168844103823`*^9}, {3.51051692150275*^9, 3.510516926880807*^9}, {
  3.510518569634822*^9, 3.51051857143799*^9}}],

Cell["\<\
Finally we define a method to carry out the integral over the scalar field \
momentum using the residue theorem.  Important question -- is it more \
efficient to calculate residues for each history or compute the residue for \
the entire thing in the end ... seems like it does a perfectly good job.\
\>", "Text",
 CellChangeTimes->{{3.510519248758263*^9, 3.5105192718187027`*^9}, {
  3.5105209418354273`*^9, 3.510520984069981*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Res", "[", "f_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"func", "=", 
     RowBox[{"Simplify", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"poly", " ", "=", " ", 
     RowBox[{"Denominator", "[", "func", "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"roots", " ", "=", " ", 
     RowBox[{"p", "/.", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"poly", "\[Equal]", "0"}], ",", "p"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"roots", " ", "=", " ", 
     RowBox[{"Abs", "[", "roots", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"roots", " ", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Split", "[", 
          RowBox[{"Sort", "[", "roots", "]"}], "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"Split", "[", 
           RowBox[{"Sort", "[", "roots", "]"}], "]"}], "]"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"res", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"Length", "[", "roots", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"res", "=", 
        RowBox[{"res", "+", 
         RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", 
          RowBox[{"Residue", "[", 
           RowBox[{"func", ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"roots", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
       ";"}]}], "]"}], ";", "\[IndentingNewLine]", "res"}], ")"}]}]], "Input",\

 CellChangeTimes->{{3.5105168523754807`*^9, 3.5105168606807528`*^9}, {
  3.510517211448312*^9, 3.510517233365705*^9}, {3.5105185145454206`*^9, 
  3.5105185148966837`*^9}, {3.5105185485031967`*^9, 3.510518550253613*^9}, {
  3.510518693359662*^9, 3.510518694145152*^9}, {3.5105192842935762`*^9, 
  3.51051935648565*^9}, {3.510519410039896*^9, 3.5105195630278873`*^9}, {
  3.510519594814279*^9, 3.510519609469743*^9}, {3.5105196767220993`*^9, 
  3.510519738550864*^9}, {3.510519840746613*^9, 3.5105198420742702`*^9}, {
  3.510519938504402*^9, 3.510519940515229*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Amp0", "=", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"0", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], " ", "2", " ", "p"}], 
    " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp2", " ", "=", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"2", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp4", " ", "=", " ", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"4", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp6", "=", " ", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"6", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp8", " ", "=", " ", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"8", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp10", "=", " ", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"10", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Amp12", " ", "=", " ", 
   RowBox[{"Res", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"ManyAmp", "[", 
       RowBox[{"12", ",", "1", ",", "1"}], "]"}]}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "p", " ", "x"}]], "2", "p"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.510520581999255*^9, 3.5105206174865923`*^9}, {
  3.510520675821849*^9, 3.510520728261145*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Amp14", " ", "=", " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"Res", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"ManyAmp", "[", 
         RowBox[{"14", ",", "1", ",", "1"}], "]"}]}], 
