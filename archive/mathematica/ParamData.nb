Cell[BoxData[
 RowBox[{
  FractionBox["9", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "36"]}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       SqrtBox["2"], " ", "x"}]]}], "+", 
    RowBox[{
     FractionBox["1", "36"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", 
       SqrtBox["2"], " ", "x"}]]}], "-", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox["2"], " ", "x"}]], " ", "x"}], 
     RowBox[{"12", " ", 
      SqrtBox["2"]}]]}], ")"}]}]], "Output",
