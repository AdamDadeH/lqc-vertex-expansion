 RowBox[{"Generate", " ", "base", " ", "with", " ", "M", " ", "changes", " ", 
  "where", " ", "greatest", " ", "deviation", " ", "is", " ", "D"}]], "Input",\

 CellChangeTimes->{{3.513988368922411*^9, 3.513988394797443*^9}, 
