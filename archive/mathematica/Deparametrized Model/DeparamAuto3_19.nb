Cell[BoxData[
 RowBox[{
  RowBox[{"Generate2", "[", 
   RowBox[{"M_", ",", "D_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"basetot", "=", 
     RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"d", "=", "0"}], ",", 
      RowBox[{"d", "\[LessEqual]", "D"}], ",", 
      RowBox[{"d", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"M", "-", "1"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"part1", "=", 
           RowBox[{"IntegerPartitions", "[", 
            RowBox[{"d", ",", 
             RowBox[{"{", "i", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"part2", "=", 
           RowBox[{"IntegerPartitions", "[", 
            RowBox[{"d", ",", 
             RowBox[{"{", 
              RowBox[{"M", "-", "i"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"len1", "=", 
           RowBox[{"Length", "[", "part1", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"len2", "=", 
           RowBox[{"Length", "[", "part2", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"len12", "=", 
           RowBox[{"len1", "*", "len2"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"bases", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "len12"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"k", "\[LessEqual]", "len1"}], ",", 
            RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"l", "=", "1"}], ",", 
               RowBox[{"l", "\[LessEqual]", "len2"}], ",", 
               RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"bases", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}], "*", "len2"}], "+", "l"}],
                    "]"}], "]"}], "=", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"part1", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                   RowBox[{"-", 
                    RowBox[{"part2", "[", 
                    RowBox[{"[", "l", "]"}], "]"}]}]}], "]"}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"basetot", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"basetot", ",", "bases"}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    ";"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.5139883967363167`*^9, 3.51398871667603*^9}, {
  3.513988861317461*^9, 3.5139889137953053`*^9}, {3.5139891376030912`*^9, 
  3.513989144337533*^9}, {3.513989522872452*^9, 3.51398954819314*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Generate3", "[", 
   RowBox[{"M_", ",", "d_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"basetot", "=", 
     RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", 
       RowBox[{"M", "-", "1"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"part1", "=", 
        RowBox[{"IntegerPartitions", "[", 
         RowBox[{"d", ",", 
          RowBox[{"{", "i", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"part2", "=", 
        RowBox[{"IntegerPartitions", "[", 
         RowBox[{"d", ",", 
          RowBox[{"{", 
           RowBox[{"M", "-", "i"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"len1", "=", 
        RowBox[{"Length", "[", "part1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"len2", "=", 
        RowBox[{"Length", "[", "part2", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"len12", "=", 
        RowBox[{"len1", "*", "len2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bases", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "len12"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "\[LessEqual]", "len1"}], ",", 
         RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"l", "=", "1"}], ",", 
            RowBox[{"l", "\[LessEqual]", "len2"}], ",", 
            RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"bases", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"k", "-", "1"}], ")"}], "*", "len2"}], "+", "l"}], 
                "]"}], "]"}], "=", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"part1", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{"part2", "[", 
                  RowBox[{"[", "l", "]"}], "]"}]}]}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"basetot", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"basetot", ",", "bases"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
