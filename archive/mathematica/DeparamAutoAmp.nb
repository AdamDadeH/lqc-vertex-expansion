  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "*", "4", "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[ImaginaryI]", " ", "*", "x", "*", " ", "k"}]], 
          FractionBox[
           RowBox[{"\[IndentingNewLine]", "1"}], 
           RowBox[{"k", " ", 
