                RowBox[{"v1", "+", "v2"}], 
                RowBox[{"2", " ", "v2"}]], "]"}]}]], "+", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "m2", " ", 
               RowBox[{"Log", "[", " ", 
                FractionBox[
                 RowBox[{"2", " ", "v1"}], 
                 RowBox[{"v1", "+", "v2"}]], "]"}]}]], 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "m1", " ", 
               RowBox[{"Log", "[", " ", 
                FractionBox[
                 RowBox[{"v1", "+", "v2"}], 
                 RowBox[{"2", " ", "v2"}]], "]"}]}]]}], "+", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[ImaginaryI]", " ", "m2", " ", 
              RowBox[{"Log", "[", " ", 
               FractionBox[
                RowBox[{"2", " ", "v1"}], 
                RowBox[{"v1", "+", "v2"}]], "]"}]}]], "+", 
