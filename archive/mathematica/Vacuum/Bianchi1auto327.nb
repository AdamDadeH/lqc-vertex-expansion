Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OffD", "[", 
    RowBox[{"v1_", ",", "v2_", ",", "m1_", ",", "m2_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
