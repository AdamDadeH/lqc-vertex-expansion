Cell["\<\
The same system expressed as a vacuum vertex expansion.  I expect it is only \
meaningful when the sums appearing are convergent or asymptotic.  For example \
for e=3 - the series below are strongly divergent!  For the positive and \
negative halves of the amplitude the grow very quickly.  For that reason it \
appears that even the ratio does not properly describe the expected physical \
inner product.  It does appear there that the Borel sum gives a result that \
does satisfy the constraint!!! Holy crap~ one question is how different \
solutions to the constraitn should appear? Starting w/ different initial \
states?\
\>", "Text",
 CellChangeTimes->{{3.510278987439144*^9, 3.5102790228691607`*^9}, {
   3.510279256607181*^9, 3.51027932260226*^9}, {3.5102796847829437`*^9, 
   3.510279732302698*^9}, 3.510332362822641*^9}],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "\[Delta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ap", "[", "n_", "]"}], ":=", 
   RowBox[{"2", 
    RowBox[{"Re", "[", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        FractionBox["\[ImaginaryI]", 
         RowBox[{"2", "\[Pi]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"2", "m"}], "+", "n"}], ",", "m"}], "]"}], " ", 
           FractionBox[
            SuperscriptBox["b", 
             RowBox[{
              RowBox[{"2", "m"}], "+", "n"}]], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"a", "+", 
               RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], 
             RowBox[{
              RowBox[{"2", "m"}], "+", "n", "+", "1"}]]]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ",",
        
       RowBox[{"\[Delta]", "\[Rule]", "0"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ap0", "=", 
   RowBox[{"2", 
    RowBox[{"Re", "[", 
     RowBox[{"Limit", "[", 
      RowBox[{
       RowBox[{
        FractionBox["\[ImaginaryI]", 
         RowBox[{"2", "\[Pi]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"2", "m"}], ",", "m"}], "]"}], " ", 
           FractionBox[
            SuperscriptBox["b", 
             RowBox[{"2", "m"}]], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"a", " ", "+", " ", 
               RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], 
             RowBox[{
              RowBox[{"2", "m"}], "+", "1"}]]]}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ",",
        
       RowBox[{"\[Delta]", "\[Rule]", "0"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.51033158737263*^9, 3.510331798259396*^9}, {
