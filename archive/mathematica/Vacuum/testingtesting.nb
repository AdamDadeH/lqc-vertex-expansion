Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Exact", "[", 
    RowBox[{"a_", ",", "b_", ",", "\[Delta]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox["a", "2"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"b", "-", 
              RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], "2"]]}]]}],
        "-", 
       RowBox[{"b", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox["a", "2"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"b", "+", 
              RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], "2"]]}]]}],
        "-", 
       RowBox[{"\[ImaginaryI]", " ", 
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"4", " ", 
            SuperscriptBox["a", "2"]}], 
           SuperscriptBox[
