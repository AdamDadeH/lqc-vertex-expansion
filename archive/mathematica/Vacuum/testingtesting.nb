Cell[CellGroupData[{

Cell["Functions Used In Evaluating Amplitudes", "Section",
 CellChangeTimes->{{3.510249373619965*^9, 3.510249392769099*^9}}],

Cell[BoxData[
 RowBox[{"Amp", " ", "generates", " ", "the", " ", "amplitude", " ", 
  "corresponding", " ", "to", " ", "a", " ", "generic", " ", "discrete", " ", 
  
  RowBox[{"history", ".", "\[IndentingNewLine]", "Changes"}], " ", "and", " ",
   "paths", " ", "together", " ", "generate", " ", "the", " ", "set", " ", 
  "of", " ", "all", " ", "possible", " ", "paths", " ", "between", " ", "the",
   " ", "initial", " ", "and", " ", "final", " ", "volume", " ", "with", " ", 
  "m", " ", 
  RowBox[{"transitions", ".", "\[IndentingNewLine]", "ManyAmp"}], " ", "them",
   " ", "takes", " ", "that", " ", "set", " ", "of", " ", "paths", " ", "and",
   " ", "computes", " ", "the", " ", "overall", " ", 
  RowBox[{"amplitude", "."}]}]], "Input",
 CellChangeTimes->{{3.510250318949498*^9, 3.510250375440337*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Nume", "[", "v_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"Length", "[", "v", "]"}], "-", "1"}]]}], 
     RowBox[{"2", "\[Pi]"}]], 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"OffD", "[", 
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"v", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", "m1", ",", "m2"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{
         RowBox[{"Length", "[", "v", "]"}], "-", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Denompos", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Diag", "[", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "m1", ",", "m2"}], "]"}], "+", 
       
       RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Denomneg", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Diag", "[", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "m1", ",", "m2"}], "]"}], "-", 
       
       RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Amp", "[", "v_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Nume", "[", "v", "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"Denompos", "[", "v", "]"}]], "-", 
      FractionBox["1", 
       RowBox[{"Denomneg", "[", "v", "]"}]]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Changes", "[", 
   RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"vf", "-", "vi"}], ")"}], "/", "4"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"base", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"4", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "+", 
            RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", "4"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"m", "/", "2"}], "-", 
            RowBox[{"diff", "/", "2"}]}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"changes", "=", 
     RowBox[{"Permutations", "[", "base", "]"}]}], ";", "\[IndentingNewLine]",
     
    RowBox[{"numpaths", "=", 
     RowBox[{"Length", "[", "changes", "]"}]}], ";"}], 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Paths", "[", 
    RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"paths", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "numpaths"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"path", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"vi", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", 
       RowBox[{"j", "\[LessEqual]", "numpaths"}], ",", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", "m"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"path", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{
              RowBox[{"changes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"paths", "[", 
          RowBox[{"[", "j", "]"}], "]"}], "=", "path"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";"}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NullPath", "[", "v_", "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ManyAmp", "[", 
   RowBox[{"m_", ",", "vi_", ",", "vf_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Changes", "[", 
     RowBox[{"m", ",", "vi", ",", "vf"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Paths", "[", 
     RowBox[{"m", ",", "vi", ",", "vf"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Many", "=", "0"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", 
       RowBox[{"Length", "[", "paths", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Many", "=", 
        RowBox[{"Many", "+", 
         RowBox[{"Amp", "[", 
          RowBox[{"paths", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "Many"}], 
   ")"}]}]}], "Input",
 CellChangeTimes->{{3.510249437590334*^9, 3.5102494511195908`*^9}, {
   3.510249481133424*^9, 3.510249635624305*^9}, {3.510249682920766*^9, 
   3.510249713918992*^9}, {3.510249783849522*^9, 3.5102498390119677`*^9}, {
   3.510249919101438*^9, 3.510249943173067*^9}, {3.510249981643935*^9, 
