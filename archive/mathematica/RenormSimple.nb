Notebook[{

Cell[CellGroupData[{
Cell["\<\
Simple Example
\
\>", "Title",
 CellChangeTimes->{{3.511828987611855*^9, 3.511828994145487*^9}}],

Cell[CellGroupData[{

Cell["n to n transition", "Section",
 CellChangeTimes->{{3.5118290185072403`*^9, 3.5118290395929937`*^9}}],

Cell["Exact Result", "Text",
 CellChangeTimes->{{3.511829044447094*^9, 3.5118290482025414`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Theta]", "]"}], "\[IndentingNewLine]", 
 FractionBox["4", 
  RowBox[{"2", "\[Pi]", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Theta]"}], "]"}]}]]}], "Input",
 CellChangeTimes->{{3.511828772419269*^9, 3.511828785492372*^9}, 
   3.511828912399461*^9, {3.511829059790967*^9, 3.511829075069542*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   RowBox[{"Csc", "[", 
    RowBox[{"2", " ", "\[Theta]"}], "]"}]}], "\[Pi]"]], "Output",
 CellChangeTimes->{
  3.511828789643381*^9, 3.5118289128519897`*^9, {3.5118290727688723`*^9, 
   3.5118290761608477`*^9}}]
}, Open  ]],

Cell["Bare Parameters", "Text",
 CellChangeTimes->{{3.5118284181930733`*^9, 3.511828418257428*^9}, {
  3.511829090033924*^9, 3.511829095214744*^9}}],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[Delta]", ",", "\[Theta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"1", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"1", "/", "2"}], "-", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], "+", 
     RowBox[{"\[ImaginaryI]", " ", "\[Delta]"}]}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.511828419075778*^9, 3.511828439860797*^9}, {
  3.511829112221382*^9, 3.5118291131689157`*^9}, {3.5118291691237993`*^9, 
  3.511829182064376*^9}}],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"\[Theta]", ",", "\[Delta]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Exact", "=", 
     RowBox[{
      FractionBox["\[ImaginaryI]", 
       RowBox[{"2", "\[Pi]"}]], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{
           RowBox[{"2", "M"}], ",", "M"}], "]"}], " ", 
         FractionBox[
          SuperscriptBox["a", 
           RowBox[{"2", "M"}]], 
          SuperscriptBox["b", 
           RowBox[{
            RowBox[{"2", " ", "M"}], "+", "1"}]]]}], ",", 
        RowBox[{"{", 
         RowBox[{"M", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Limit", "[", 
     RowBox[{"Exact", ",", 
      RowBox[{"\[Delta]", "\[Rule]", "0"}]}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.511828472439394*^9, 3.511828538171001*^9}, {
  3.511828587730033*^9, 3.511828619195922*^9}, {3.511828841687314*^9, 
  3.5118288761502533`*^9}, {3.511828916743483*^9, 3.511828947543579*^9}, {
  3.511829126147002*^9, 3.5118291413794737`*^9}, {3.511829204635335*^9, 
  3.511829245822407*^9}, {3.511829316620921*^9, 3.511829319076993*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[ImaginaryI]", " ", 
   RowBox[{"Sec", "[", 
    RowBox[{"2", " ", "\[Theta]"}], "]"}]}], 
  RowBox[{"\[Pi]", " ", 
   SqrtBox[
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"Tan", "[", 
       RowBox[{"2", " ", "\[Theta]"}], "]"}], "2"]}]]}]]], "Input",
 CellChangeTimes->{{3.51182932937731*^9, 3.511829331733706*^9}}],

Cell["Renormalization Flow of y = 1/b and x = b/a", "Text",
 CellChangeTimes->{{3.511829268104066*^9, 3.511829297169715*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "0", "]"}], "=", 
   FractionBox["1", "b"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", 
   FractionBox["b", "a"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "1", "]"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"x", "[", "0", "]"}], "2"], "-", "2"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "1", "]"}], "=", 
   RowBox[{
    RowBox[{"y", "[", "0", "]"}], "*", 
    FractionBox["1", 
     RowBox[{"1", "-", 
      FractionBox["2", 
       SuperscriptBox[
        RowBox[{"x", "[", "0", "]"}], "2"]]}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.5118293428869143`*^9, 3.511829516933921*^9}}],

Cell["Renormalized Sum converges to the same exact expression", "Text",
 CellChangeTimes->{{3.5118297791216087`*^9, 3.511829788683711*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Exact1", "=", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     RowBox[{"2", "\[Pi]"}]], " ", 
    RowBox[{"y", "[", "1", "]"}], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{
         RowBox[{"2", "M"}], ",", "M"}], "]"}], " ", 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"x", "[", "1", "]"}], 
         RowBox[{"2", "M"}]]]}], ",", 
      RowBox[{"{", 
       RowBox[{"M", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.511829531727511*^9, 3.511829563292851*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"Exact1", ",", 
   RowBox[{"\[Delta]", "\[Rule]", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.511829572909238*^9, 3.511829603613275*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", "\[ImaginaryI]", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "\[Theta]"}], "]"}], " ", 
   RowBox[{"Sec", "[", 
    RowBox[{"4", " ", "\[Theta]"}], "]"}]}], 
  RowBox[{"\[Pi]", " ", 
   SqrtBox[
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"Tan", "[", 
       RowBox[{"4", " ", "\[Theta]"}], "]"}], "2"]}]]}]]], "Output",
 CellChangeTimes->{3.511829695650309*^9}]
}, Open  ]],

Cell["\<\
Now we see how well the first term approximates the exact answer under renorm \
group.\
\>", "Text",
 CellChangeTimes->{{3.51182970859951*^9, 3.5118297298300037`*^9}, {
  3.5118297974849052`*^9, 3.51182981591162*^9}}],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[Theta]", ",", "\[Delta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", "0", "]"}], "=", 
   FractionBox["1", "b"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", 
   FractionBox["b", "a"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", 
    RowBox[{"n", "\[LessEqual]", "50"}], ",", 
    RowBox[{"n", "++"}], ",", " ", 
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"n", "+", "1"}], "]"}], "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"x", "[", "n", "]"}], "2"], "-", "2"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", 
    RowBox[{"n", "\[LessEqual]", "50"}], ",", 
    RowBox[{"n", "++"}], ",", " ", 
    RowBox[{
     RowBox[{"y", "[", 
      RowBox[{"n", "+", "1"}], "]"}], " ", "=", 
     RowBox[{
      RowBox[{"y", "[", "n", "]"}], 
      FractionBox["1", 
       RowBox[{"1", "-", 
        FractionBox["2", 
         SuperscriptBox[
          RowBox[{"x", "[", "n", "]"}], "2"]]}]]}]}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.51182981710353*^9, 3.5118299108361998`*^9}, {
  3.511829971772245*^9, 3.511829975140481*^9}, {3.511830031958887*^9, 
  3.5118300345301533`*^9}, {3.511830095479164*^9, 3.511830110604196*^9}, {
  3.511830353372315*^9, 3.511830363844803*^9}, {3.511830529637801*^9, 
  3.5118305315185747`*^9}}],

Cell["\<\
We see that if keep turning the crank the first term approaches the exact \
answer!\
\>", "Text",
 CellChangeTimes->{{3.51183055625298*^9, 3.511830571929809*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{"\[Pi]", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 FractionBox["4.", 
  RowBox[{"2", "\[Pi]", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"2", "\[Theta]"}], "]"}]}]]}], "Input",
 CellChangeTimes->{{3.5118303739653*^9, 3.5118303977157373`*^9}, {
  3.5118305012951403`*^9, 3.5118305505804253`*^9}, {3.511832745584073*^9, 
  3.5118327639290047`*^9}, {3.51183280041183*^9, 3.5118328450058727`*^9}, {
  3.5118328788735332`*^9, 3.511832890007536*^9}, {3.5118329534828253`*^9, 
  3.5118330074144363`*^9}}],

Cell[BoxData["0.6366197723675814`"], "Output",
 CellChangeTimes->{{3.511830390633917*^9, 3.5118303980278187`*^9}, {
  3.511830506503872*^9, 3.51183055120258*^9}, {3.511832751250143*^9, 
  3.5118327646966248`*^9}, {3.511832804070333*^9, 3.51183284600768*^9}, {
  3.5118328798618298`*^9, 3.5118328906278*^9}, {3.511832955559051*^9, 
  3.511833007873104*^9}}]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"Renorm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"Re", "[", 
       RowBox[{
        FractionBox["\[ImaginaryI]", 
         RowBox[{"2", "\[Pi]"}]], 
        RowBox[{"y", "[", "n", "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "30"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.511832649018608*^9, 3.511832730832169*^9}, {
  3.5118328758361*^9, 3.511832877103408*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"ListPlot", "[", "Renorm", "]"}]}]], "Input",
 CellChangeTimes->{{3.511832666994563*^9, 3.511832683999749*^9}}],

